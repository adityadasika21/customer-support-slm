# The comparison front end. CPU-only and tiny: it holds no model code and no tokenizer, it
# only speaks HTTP to vLLM and to the API.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir "streamlit>=1.40" "httpx>=0.28"
COPY ui/ ./ui/
EXPOSE 8501
HEALTHCHECK --interval=15s --timeout=5s --retries=20 --start-period=40s \
  CMD curl -fsS http://localhost:8501/_stcore/health || exit 1
CMD ["streamlit", "run", "ui/app.py", "--server.address=0.0.0.0", "--server.port=8501", \
     "--server.headless=true", "--browser.gatherUsageStats=false"]
